#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

//GPU LOD generation: computes the internal mip levels of a VoxelizedSection in place.
//Layout matches VoxelizedSection: [4096 L0 (16^3)][512 L1 (8^3)][64 L2 (4^3)][8 L3 (2^3)][1 L4 (1^3)]
layout(binding = 0, std430) restrict buffer SectionData {
    uint64_t[] section;
};

//Opacity (0..15) per block id, indexed by the block id bits of the packed voxel
layout(binding = 1, std430) restrict readonly buffer OpacityTable {
    uint[] opacityTable;
};

layout(push_constant) uniform PushConstants {
    int level;
} pc;

const uint64_t AIR_MASK = uint64_t(0xFFFFFu) << 27;//0x000FFFFF00000000 (block id bits 27..46)
const uint64_t LIGHT_MASK = uint64_t(0xFFu) << 56;
const uint BASE_OFFSETS[5] = uint[](0, 4096, 4608, 4672, 4680);

bool isAir(uint64_t v) {
    return (v & AIR_MASK) == uint64_t(0u);
}

uint getBlockId(uint64_t v) {
    return uint((v >> 27) & uint64_t(0xFFFFFu));
}

int getOpacity(uint64_t v) {
    uint id = getBlockId(v);
    if (id >= opacityTable.length()) {
        id = opacityTable.length() - 1u;
    }
    return int(opacityTable[id]);
}

uint getLight(uint64_t v) {
    return uint((v >> 56) & uint64_t(0xFFu));
}

uint64_t withLight(uint64_t v, uint light) {
    return (v & ~LIGHT_MASK) | (uint64_t(light & 0xFFu) << 56);
}

//Exact port of Mipper.mip: pick the non-air child with the highest (opacity<<4)|cornerIndex,
//otherwise average the light and apply it to the I111 corner
uint64_t mip8(uint64_t children[8]) {
    int best = -1;
    for (int i = 0; i < 8; i++) {
        if (!isAir(children[i])) {
            best = max(best, (getOpacity(children[i]) << 4) | i);
        }
    }

    if (best >= 0) {
        return children[best & 7];
    }

    uint blockLight = 0;
    uint skyLight = 0;
    for (int i = 0; i < 8; i++) {
        blockLight += getLight(children[i]) & 0xF0u;
        skyLight += getLight(children[i]) & 0x0Fu;
    }
    blockLight = (blockLight / 8u) & 0xF0u;
    skyLight = (skyLight + 7u) / 8u;
    return withLight(children[7], blockLight | skyLight);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    int lvl = pc.level;
    if (lvl < 1 || lvl > 4) {
        return;
    }

    uint size = uint(16 >> lvl);
    if (id >= size * size * size) {
        return;
    }

    uint x = id & (size - 1u);
    uint y = (id >> (4 - lvl)) & (size - 1u);
    uint z = id >> (2 * (4 - lvl));

    uint prevLevelShift = 5 - lvl;
    uint prevSize = uint(16 >> (lvl - 1));
    uint prevBase = BASE_OFFSETS[lvl - 1];

    uint64_t children[8];
    for (int cz = 0; cz < 2; cz++) {
        for (int cy = 0; cy < 2; cy++) {
            for (int cx = 0; cx < 2; cx++) {
                uint px = (x << 1) + uint(cx);
                uint py = (y << 1) + uint(cy);
                uint pz = (z << 1) + uint(cz);
                uint idx = (py << (prevLevelShift << 1)) | (pz << prevLevelShift) | px;
                children[(cx << 2) | (cy << 1) | cz] = section[prevBase + idx];
            }
        }
    }

    uint outIdx = BASE_OFFSETS[lvl] + (y << (2 * (4 - lvl))) | (z << (4 - lvl)) | x;
    section[outIdx] = mip8(children);
}
