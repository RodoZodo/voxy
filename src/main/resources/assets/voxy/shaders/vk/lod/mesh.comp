#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

//GPU greedy mesher (opaque passes), per-section. One workgroup per section.
//
//Slot buffer layout (bytes, must match VkMeshGenerator):
//  0           rawData[32768] u64
//  262144      neighborFaces[6144] u64
//  311296      sectionData[65536] u64
//  835584      opaqueMasks/nonOpaqueMasks/fluidMasks[1024] u32 each
//  847872      quads[LANE_CAP*8] u64
//  847872+...  laneCounts[8] u32, aabb u32, totalQuads u32, flags u32,
//              aabbMinX/Y/Z, aabbMaxX/Y/Z int
//
//Flags: bit0 = missing model id, bit1 = quad lane overflow

layout(local_size_x = 64) in;

#define LANE_CAP 16384
#define MAX_SIZE 16

layout(binding = 0, std430) restrict readonly buffer IdMappings {
    int[] idMappings;
};

layout(binding = 1, std430) restrict readonly buffer MetadataCache {
    uint64_t[] metadataCache;
};

layout(binding = 3, std430) restrict readonly buffer FluidLUT {
    int[] fluidLUT;
};

layout(binding = 2, std430) restrict buffer Slot {
    uint64_t rawData[32768];
    uint64_t neighborFaces[6144];
    uint64_t sectionData[65536];
    uint opaqueMasks[1024];
    uint nonOpaqueMasks[1024];
    uint fluidMasks[1024];
    uint64_t quads[LANE_CAP * 8];
    uint laneCounts[8];
    uint aabb;
    uint totalQuads;
    uint flags;
    int aabbMinX;
    int aabbMinY;
    int aabbMinZ;
    int aabbMaxX;
    int aabbMaxY;
    int aabbMaxZ;
} slot;

const uint64_t LM = uint64_t(0xFFu) << 55;

bool isAirId(uint64_t id) { return (id & (uint64_t(0xFFFFFu) << 27)) == uint64_t(0u); }
uint getBlockId(uint64_t id) { return uint((id >> 27) & uint64_t(0xFFFFFu)); }
uint getLightId(uint64_t id) { return uint((id >> 56) & uint64_t(0xFFu)); }

uint mdIsBiomeColoured(uint64_t m) { return uint((m >> 48) & uint64_t(1u)); }
uint mdIsTranslucent(uint64_t m) { return uint((m >> 49) & uint64_t(1u)); }
uint mdIsDoubleSided(uint64_t m) { return uint((m >> 50) & uint64_t(1u)); }
uint mdContainsFluid(uint64_t m) { return uint((m >> 51) & uint64_t(1u)); }
uint mdIsFluid(uint64_t m) { return uint((m >> 52) & uint64_t(1u)); }
uint mdCullsSame(uint64_t m) { return uint((m >> 53) & uint64_t(1u)); }
uint mdIsFullyOpaque(uint64_t m) { return uint((m >> 54) & uint64_t(1u)); }
uint mdLightEmission(uint64_t m) { return uint((m >> 55) & uint64_t(0xFu)); }

bool faceExists(uint64_t m, uint f) { return ((m >> (8u * f)) & uint64_t(0xFFu)) != uint64_t(0xFFu); }
bool faceOccludes(uint64_t m, uint f) { return faceExists(m, f) && ((m >> (8u * f)) & uint64_t(1u)) != uint64_t(0u); }

uint getQuadTyping(uint64_t m) {
    return uint(uint64_t(20u) >> (mdIsTranslucent(m) * 6u + mdIsDoubleSided(m) * 3u)) & 7u;//0b000_000_010_100 = 20
}

uint64_t packPartialQuadData(int modelId, uint64_t state, uint64_t metadata) {
    uint64_t lightAndBiome = (state & ((uint64_t(0x1FFu) << 47) | (uint64_t(0xFFu) << 56))) >> 1;
    if (mdIsBiomeColoured(metadata) == 0u) lightAndBiome &= ~(uint64_t(0x1FFu) << 46);
    if (mdIsFullyOpaque(metadata) != 0u) lightAndBiome &= ~(uint64_t(0xFFu) << 55);
    return lightAndBiome | (uint64_t(modelId) << 26) | getQuadTyping(metadata);
}

uint64_t applyQuadLight(uint64_t quad, uint64_t selfmeta) {
    const uint64_t BLMSK = uint64_t(0xFu) << 59;
    uint64_t bl = quad & BLMSK;
    bl = max(bl, uint64_t(mdLightEmission(selfmeta)) << 59);
    return (quad & ~BLMSK) | bl;
}

//Safety net for a missing neighbor model id (idMappings -1): can't index metadataCache
int idMappingsSafe(int blockId) {
    int cid = idMappings[blockId];
    if (cid == -1) {
        atomicOr(slot.flags, 1u);
        return 0;
    }
    return cid;
}

uint64_t metadataSafe(int modelId) {
    if (modelId < 0 || modelId >= 65536) return uint64_t(0u);
    return metadataCache[modelId];
}


bool faceCanBeOccluded(uint64_t m, uint f) { return ((m >> (8u * f)) & uint64_t(4u)) != uint64_t(0u); }
bool faceUsesSelfLighting(uint64_t m, uint f) { return ((m >> (8u * f)) & uint64_t(8u)) != uint64_t(0u); }

int fluidSafe(int modelId) {
    int v = fluidLUT[modelId];
    if (v == -1) {
        atomicOr(slot.flags, 1u);
        return modelId;
    }
    return v;
}

int tz(uint v) { return findLSB(v); }
int tz(int v) { return findLSB(v); }

struct Mesher {
    uint rowBitset;
    uint currentIndex;
    int rowLength[32];
    int rowDepth[32];
    uint64_t rowData[32];
    uint64_t currentData;
    int currentSum;
    int axis;
    int auxPos;
    int doAux;
};

Mesher newMesher(int axis, int auxPos, int doAux) {
    Mesher m;
    m.rowBitset = 0u;
    m.currentIndex = 0u;
    m.currentData = uint64_t(0u);
    m.currentSum = 0;
    m.axis = axis;
    m.auxPos = auxPos;
    m.doAux = doAux;
    for (int i = 0; i < 32; i++) {
        m.rowLength[i] = 0;
        m.rowDepth[i] = 0;
        m.rowData[i] = uint64_t(0u);
    }
    return m;
}

void emitQuad(int x, int z, int length, int width, uint64_t data, inout Mesher m) {
    uint aux = uint(data & uint64_t((1u << 26) - 1u));
    uint side = aux & 1u;
    uint type = (aux >> 1u) & 3u;
    uint64_t payload = data & ~uint64_t((1u << 26) - 1u);
    int face = (m.axis << 1) | int(side);
    x -= length - 1;
    z -= width - 1;
    if (m.axis == 2) {
        int tmp = x; x = z; z = tmp;
        tmp = length; length = width; width = tmp;
    }
    int auxPos = m.auxPos + 1 - (m.doAux != 0 ? int(side) : 1);
    int enc = face;
    enc |= ((width - 1) << 7) | ((length - 1) << 3);
    enc |= x << (m.axis == 2 ? 16 : 21);
    enc |= z << (m.axis == 1 ? 16 : 11);
    int shift = m.axis == 0 ? 16 : (m.axis == 1 ? 11 : 21);
    enc |= auxPos << shift;
    uint64_t quad = payload | uint64_t(uint(enc));
    int lane = int(type) + (type == 2u ? face : 0);
    uint idx = atomicAdd(slot.laneCounts[lane], 1u);
    if (idx >= uint(LANE_CAP)) {
        atomicOr(slot.flags, 2u);
        return;
    }
    slot.quads[lane * LANE_CAP + int(idx)] = quad;
    int minX, minY, minZ, maxX, maxY, maxZ;
    if (m.axis == 0) {
        minX = x; maxX = x + length;
        minZ = z; maxZ = z + width;
        minY = auxPos; maxY = auxPos + 1;
    } else if (m.axis == 1) {
        minX = x; maxX = x + length;
        minY = z; maxY = z + width;
        minZ = auxPos; maxZ = auxPos + 1;
    } else {
        minX = auxPos; maxX = auxPos + 1;
        minY = x; maxY = x + length;
        minZ = z; maxZ = z + width;
    }
    atomicMin(slot.aabbMinX, minX);
    atomicMin(slot.aabbMinY, minY);
    atomicMin(slot.aabbMinZ, minZ);
    atomicMax(slot.aabbMaxX, maxX);
    atomicMax(slot.aabbMaxY, maxY);
    atomicMax(slot.aabbMaxZ, maxZ);
}

void emitRanged(inout Mesher m, int msk) {
    int rowSet = int(m.rowBitset) & msk;
    m.rowBitset &= uint(~msk);
    while (rowSet != 0) {
        int index = tz(uint(rowSet));
        rowSet &= rowSet - 1;
        emitQuad(index, int((m.currentIndex >> 5) - 1u), m.rowLength[index], m.rowDepth[index], m.rowData[index], m);
    }
}

void mesherPutNext(inout Mesher m, uint64_t data) {
    uint idx = (m.currentIndex++) & 31u;

    if (idx == 0u) {
        if (m.currentData != uint64_t(0u)) {
            if ((m.rowBitset & (1u << 31)) != 0u) {
                emitQuad(31, int(((m.currentIndex - 1u) >> 5) - 1u), m.rowLength[31], m.rowDepth[31], m.rowData[31], m);
            }
            m.rowBitset |= 1u << 31;
            m.rowLength[31] = m.currentSum;
            m.rowDepth[31] = 1;
            m.rowData[31] = m.currentData;
        }
        m.currentData = data;
        m.currentSum = 0;
    }

    if (data != m.currentData || m.currentSum == MAX_SIZE) {
        if (m.currentData != uint64_t(0u)) {
            int prev = int(idx) - 1;
            m.rowDepth[prev] = 1;
            m.rowLength[prev] = m.currentSum;
            m.rowData[prev] = m.currentData;
            m.rowBitset |= 1u << uint(prev);
        }
        m.currentData = data;
        m.currentSum = 0;
    }
    m.currentSum++;

    bool isSet = (m.rowBitset & (1u << idx)) != 0u;
    bool causedByDepthMax = false;
    if (m.currentData != uint64_t(0u) && isSet &&
        m.rowLength[int(idx)] == m.currentSum && m.rowData[int(idx)] == m.currentData) {
        int depth = ++m.rowDepth[int(idx)];
        m.currentSum = 0;
        m.currentData = uint64_t(0u);
        if (depth != MAX_SIZE) return;
        causedByDepthMax = true;
    }
    if (isSet) {
        uint row = (m.currentIndex - 1u) >> 5;
        emitQuad(int(idx), int(row) - (causedByDepthMax ? 0 : 1), m.rowLength[int(idx)], m.rowDepth[int(idx)], m.rowData[int(idx)], m);
        m.rowBitset &= ~(1u << idx);
    }
}

void mesherSkip(inout Mesher m, int count) {
    if (count == 0) return;
    if (m.currentData != uint64_t(0u)) {
        mesherPutNext(m, uint64_t(0u));
        count--;
    }
    if (0 < count) {
        uint64_t ones = count >= 32 ? uint64_t(0xFFFFFFFFu) : ((uint64_t(1u) << uint(count)) - uint64_t(1u));
        int msk = int(ones << (m.currentIndex & 31u));
        emitRanged(m, msk);
        m.currentIndex += uint(count);
    }
}

void mesherEndRow(inout Mesher m) {
    if ((m.currentIndex & 31u) != 0u) {
        mesherSkip(m, int(32u - (m.currentIndex & 31u)));
    }
}

void mesherFinish(inout Mesher m) {
    if (m.currentIndex != 0u) {
        mesherSkip(m, int(32u - (m.currentIndex & 31u)));
        emitRanged(m, -1);
    }
}

bool shouldMeshNonOpaqueBlockFace(uint face, uint64_t quad, uint64_t meta, uint64_t neighborQuad, uint64_t neighborMeta) {
    if (((quad ^ neighborQuad) & (uint64_t(0xFFFFu) << 26)) == uint64_t(0u) && mdCullsSame(meta) != 0u) return false;
    if (!faceExists(meta, face)) return false;
    if (faceCanBeOccluded(meta, face) && faceOccludes(neighborMeta, face ^ 1u)) return false;
    return true;
}

void meshNonOpaqueFace(uint face, uint64_t quad, uint64_t meta, uint64_t neighborQuad, uint64_t neighborMeta, inout Mesher m) {
    if (shouldMeshNonOpaqueBlockFace(face, quad, meta, neighborQuad, neighborMeta)) {
        mesherPutNext(m, applyQuadLight(uint64_t(face & 1u) | (quad & ~LM) | ((faceUsesSelfLighting(meta, face) ? quad : neighborQuad) & LM), meta));
    } else {
        mesherSkip(m, 1);
    }
}

void dualMeshNonOpaqueOuterX(uint side, uint64_t quad, uint64_t meta, uint neighborAId, uint neighborLight, uint64_t neighborAMeta, uint64_t neighborBQuad, uint64_t neighborBMeta, inout Mesher ma, inout Mesher mb) {
    bool doMa = false;
    bool doMb = false;
    if (neighborAId == 0u) {
        doMa = faceExists(meta, 4u ^ side);
    } else {
        doMa = shouldMeshNonOpaqueBlockFace(4u ^ side, quad, meta, uint64_t(neighborAId) << 26, neighborAMeta);
    }
    uint bFace = 5u ^ side;
    doMb = shouldMeshNonOpaqueBlockFace(bFace, quad, meta, neighborBQuad, neighborBMeta);
    if (doMa) {
        mesherPutNext(ma, applyQuadLight(uint64_t(side) | (quad & ~LM) | (faceUsesSelfLighting(meta, 4u ^ side) ? quad : (uint64_t(neighborLight) << 55) ) & LM, meta));
    } else {
        mesherSkip(ma, 1);
    }
    if (doMb) {
        mesherPutNext(mb, applyQuadLight(uint64_t(side ^ 1u) | (quad & ~LM) | ((faceUsesSelfLighting(meta, bFace) ? quad : neighborBQuad) & LM), meta));
    } else {
        mesherSkip(mb, 1);
    }
}







//--------------------------------------------------------------- opaque mesh passes

#define CHECK_NEIGHBOR_FACE_OCCLUSION 1

void meshYZOpaqueInnerPlane(int layer, int axis) {
    Mesher m = newMesher(axis, layer, 1);
    int cSkip = 0;
    for (int other = 0; other < 32; other++) {
        int pidx = axis == 0 ? (layer * 32 + other) : (other * 32 + layer);
        int skipAmount = axis == 0 ? 32 : 1;
        uint current = slot.opaqueMasks[pidx];
        uint next = slot.opaqueMasks[pidx + skipAmount];
        uint msk = current ^ next;
        if (msk == 0u) {
            cSkip += 32;
            continue;
        }
        mesherSkip(m, cSkip);
        cSkip = 0;

        uint faceForwardMsk = msk & current;
        int cIdx = -1;
        while (msk != 0u) {
            int index = tz(msk);
            int delta = index - cIdx - 1;
            cIdx = index;
            if (delta != 0) mesherSkip(m, delta);
            msk &= msk - 1u;

            int facingForward = int((faceForwardMsk >> uint(index)) & 1u);
            int idx = index + pidx * 32;
            int shift = skipAmount * 32 * 2;
            int iA = idx * 2 + (facingForward == 1 ? 0 : shift);
            int iB = idx * 2 + (facingForward == 1 ? shift : 0);

            uint64_t selfModel = slot.sectionData[iA];
            uint64_t selfMeta = slot.sectionData[iA + 1];
            uint64_t nextModel = slot.sectionData[iB];

            if (CHECK_NEIGHBOR_FACE_OCCLUSION != 0) {
                uint64_t neighbor = slot.sectionData[iB + 1];
                bool culls = false;
                culls = culls || (((selfModel ^ nextModel) & (uint64_t(0xFFFFu) << 26)) == uint64_t(0u) && mdCullsSame(neighbor) != 0u);
                culls = culls || faceOccludes(neighbor, uint((axis << 1) | (1 - facingForward)));
                if (culls) {
                    mesherSkip(m, 1);
                    continue;
                }
            }
            mesherPutNext(m, applyQuadLight(uint64_t(facingForward) | (selfModel & ~LM) | (nextModel & LM), selfMeta));
        }
        mesherEndRow(m);
    }
    mesherFinish(m);
}

void meshYZOpaqueOuterPlane(int side, int axis) {
    Mesher m = newMesher(axis, side == 0 ? 0 : 31, 0);
    int layer = side == 0 ? 0 : 31;
    int cSkips = 0;
    for (int other = 0; other < 32; other++) {
        int pidx = axis == 0 ? (layer * 32 + other) : (other * 32 + layer);
        uint msk = slot.opaqueMasks[pidx];
        if (msk == 0u) {
            cSkips += 32;
            continue;
        }
        mesherSkip(m, cSkips);
        cSkips = 0;

        int cIdx = -1;
        while (msk != 0u) {
            int index = tz(msk);
            int delta = index - cIdx - 1;
            cIdx = index;
            if (delta != 0) mesherSkip(m, delta);
            msk &= msk - 1u;

            int idx = index + pidx * 32;
            int neighborIdx = ((axis + 1) * 1024 * 2) + side * 1024;
            uint64_t neighborId = slot.neighborFaces[neighborIdx + other * 32 + index];
            uint64_t A = slot.sectionData[idx * 2];
            uint64_t selfMeta = slot.sectionData[idx * 2 + 1];

            int nib = int(getBlockId(neighborId));
            if (nib != 0) {
                int cid = idMappingsSafe(nib);
                uint64_t meta = metadataSafe(cid);
                if (mdIsFullyOpaque(meta) != 0u) {
                    mesherSkip(m, 1);
                    continue;
                }
                if (CHECK_NEIGHBOR_FACE_OCCLUSION != 0) {
                    bool culls = false;
                    culls = culls || (cid == int((A >> 26) & uint64_t(0xFFFFu)) && mdCullsSame(meta) != 0u);
                    culls = culls || faceOccludes(meta, uint((axis << 1) | (1 - side)));
                    if (culls) {
                        mesherSkip(m, 1);
                        continue;
                    }
                }
            }
            mesherPutNext(m, applyQuadLight(uint64_t(side == 0 ? 0 : 1) | (A & ~LM) | ((neighborId & (uint64_t(0xFFu) << 56)) >> 1), selfMeta));
        }
        mesherEndRow(m);
    }
    mesherFinish(m);
}

void meshXOpaqueInnerPlane(int xplane) {
    Mesher m = newMesher(2, xplane, 1);
    for (int y = 0; y < 32; y++) {
        int skipCount = 0;
        for (int z = 0; z < 32; z++) {
            uint lMsk = slot.opaqueMasks[y * 32 + z];
            uint boundary = (lMsk ^ (lMsk >> 1)) & 0x7FFFFFFFu;
            if (((boundary >> uint(xplane)) & 1u) == 0u) {
                skipCount++;
                continue;
            }
            mesherSkip(m, skipCount);
            skipCount = 0;
            int facingForward = int((lMsk >> uint(xplane)) & 1u);
            int idx = xplane + z * 32 + y * 1024;
            int iA = idx * 2 + (facingForward == 1 ? 0 : 2);
            int iB = idx * 2 + (facingForward == 1 ? 2 : 0);
            if (CHECK_NEIGHBOR_FACE_OCCLUSION != 0) {
                if (faceOccludes(slot.sectionData[iB + 1], uint((2 << 1) | (1 - facingForward)))) {
                    mesherSkip(m, 1);
                    continue;
                }
            }
            uint64_t selfModel = slot.sectionData[iA];
            uint64_t selfMeta = slot.sectionData[iA + 1];
            uint64_t nextModel = slot.sectionData[iB];
            mesherPutNext(m, applyQuadLight(uint64_t(facingForward) | (selfModel & ~LM) | (nextModel & LM), selfMeta));
        }
        mesherSkip(m, skipCount);
    }
    mesherFinish(m);
}

void meshXOpaqueOuterPlane(int side) {
    int xplane = side == 0 ? 0 : 31;
    Mesher m = newMesher(2, xplane, 0);
    for (int y = 0; y < 32; y++) {
        int skip = 0;
        for (int z = 0; z < 32; z++) {
            int i = y * 32 + z;
            uint msk = slot.opaqueMasks[i];
            int bit = side == 0 ? int(msk & 1u) : int((msk >> 31) & 1u);
            if (bit == 0) {
                skip++;
                continue;
            }
            int neighborIdx = side == 0 ? i : i + 1024;
            uint64_t neighborId = slot.neighborFaces[neighborIdx];
            bool oki = true;
            int nib = int(getBlockId(neighborId));
            if (nib != 0) {
                int cid = idMappingsSafe(nib);
                uint64_t meta = metadataSafe(cid);
                if (mdIsFullyOpaque(meta) != 0u) {
                    oki = false;
                } else if (CHECK_NEIGHBOR_FACE_OCCLUSION != 0 && faceOccludes(meta, uint((2 << 1) | (1 - side)))) {
                    oki = false;
                }
            }
            if (oki) {
                mesherSkip(m, skip);
                skip = 0;
                int bi = side == 0 ? (i << 5) : (i * 32 + 31);
                uint64_t A = slot.sectionData[bi * 2];
                uint64_t Am = slot.sectionData[bi * 2 + 1];
                mesherPutNext(m, applyQuadLight(uint64_t(side) | (A & ~LM) | ((neighborId & (uint64_t(0xFFu) << 56)) >> 1), Am));
            } else {
                skip++;
            }
        }
        mesherSkip(m, skip);
    }
    mesherFinish(m);
}

//--------------------------------------------------------------- fluid passes

void meshYZFluidInnerPlane(int layer, int axis) {
    Mesher m = newMesher(axis, layer, 1);
    int cSkip = 0;
    for (int other = 0; other < 32; other++) {
        int pidx = axis == 0 ? (layer * 32 + other) : (other * 32 + layer);
        int skipAmount = axis == 0 ? 32 : 1;
        uint curFluid = slot.fluidMasks[pidx];
        uint nextFluid = slot.fluidMasks[pidx + skipAmount];
        uint curOp = slot.opaqueMasks[pidx];
        uint nextOp = slot.opaqueMasks[pidx + skipAmount];
        uint msk = (curFluid | curOp) ^ (nextFluid | nextOp);
        msk &= curFluid | nextFluid;
        if (msk == 0u) { cSkip += 32; continue; }
        mesherSkip(m, cSkip); cSkip = 0;
        uint faceForwardMsk = msk & curFluid;
        int cIdx = -1;
        while (msk != 0u) {
            int index = tz(msk);
            int delta = index - cIdx - 1; cIdx = index;
            if (delta != 0) mesherSkip(m, delta);
            msk &= msk - 1u;
            int facingForward = int((faceForwardMsk >> uint(index)) & 1u);
            int idx = index + pidx * 32;
            int shift = skipAmount * 32 * 2;
            int iA = idx * 2 + (facingForward == 1 ? 0 : shift);
            int iB = idx * 2 + (facingForward == 1 ? shift : 0);
            uint64_t A = slot.sectionData[iA];
            uint64_t Am = slot.sectionData[iA + 1];
            if (mdContainsFluid(Am) != 0u) {
                int fluidId = fluidSafe(int((A >> 26) & uint64_t(0xFFFFu)));
                uint64_t fluidMeta = metadataSafe(fluidId);
                A = (A & ~(uint64_t(0xFFFFu) << 26)) | (uint64_t(fluidId) << 26);
                A = (A & ~uint64_t(6u)) | getQuadTyping(fluidMeta);
                Am = fluidMeta;
            }
            if (CHECK_NEIGHBOR_FACE_OCCLUSION != 0) {
                uint64_t neighbor = slot.sectionData[iB + 1];
                if (faceOccludes(neighbor, uint((axis << 1) | (1 - facingForward)))) { mesherSkip(m, 1); continue; }
            }
            uint64_t nextModel = slot.sectionData[iB];
            mesherPutNext(m, applyQuadLight(uint64_t(facingForward) | (A & ~LM) | (nextModel & LM), Am));
        }
        mesherEndRow(m);
    }
    mesherFinish(m);
}

void meshYZFluidOuterPlane(int side, int axis) {
    Mesher m = newMesher(axis, side == 0 ? 0 : 31, 0);
    int layer = side == 0 ? 0 : 31;
    int cSkips = 0;
    for (int other = 0; other < 32; other++) {
        int pidx = axis == 0 ? (layer * 32 + other) : (other * 32 + layer);
        uint msk = slot.fluidMasks[pidx];
        if (msk == 0u) { cSkips += 32; continue; }
        mesherSkip(m, cSkips); cSkips = 0;
        int cIdx = -1;
        while (msk != 0u) {
            int index = tz(msk);
            int delta = index - cIdx - 1; cIdx = index;
            if (delta != 0) mesherSkip(m, delta);
            msk &= msk - 1u;
            int idx = index + pidx * 32;
            int neighborIdx = ((axis + 1) * 1024 * 2) + side * 1024;
            uint64_t neighborId = slot.neighborFaces[neighborIdx + other * 32 + index];
            uint64_t A = slot.sectionData[idx * 2];
            uint64_t selfMeta = slot.sectionData[idx * 2 + 1];
            if (mdContainsFluid(selfMeta) != 0u) {
                int fluidId = fluidSafe(int((A >> 26) & uint64_t(0xFFFFu)));
                uint64_t fluidMeta = metadataSafe(fluidId);
                A = (A & ~(uint64_t(0xFFFFu) << 26)) | (uint64_t(fluidId) << 26);
                A = (A & ~uint64_t(6u)) | getQuadTyping(fluidMeta);
                selfMeta = fluidMeta;
            }
            int nib = int(getBlockId(neighborId));
            if (nib != 0) {
                int cid = idMappingsSafe(nib);
                uint64_t meta = metadataSafe(cid);
                if (mdContainsFluid(meta) != 0u) {
                    int fluidId2 = fluidSafe(cid);
                    if (fluidId2 != cid) { cid = fluidId2; meta = metadataSafe(cid); }
                }
                bool culls = false;
                culls = culls || (cid == int((A >> 26) & uint64_t(0xFFFFu)) && mdCullsSame(selfMeta) != 0u);
                culls = culls || faceOccludes(meta, uint((axis << 1) | (1 - side)));
                if (culls) { mesherSkip(m, 1); continue; }
            }
            mesherPutNext(m, applyQuadLight(uint64_t(side == 0 ? 0 : 1) | (A & ~LM) | ((neighborId & (uint64_t(0xFFu) << 56)) >> 1), selfMeta));
        }
        mesherEndRow(m);
    }
    mesherFinish(m);
}

void meshXFluidInnerPlane(int xplane) {
    Mesher m = newMesher(2, xplane, 1);
    for (int y = 0; y < 32; y++) {
        int skipCount = 0;
        for (int z = 0; z < 32; z++) {
            uint oMsk = slot.opaqueMasks[y * 32 + z];
            uint fMsk = slot.fluidMasks[y * 32 + z];
            uint lMsk = oMsk | fMsk;
            uint boundary = (lMsk ^ (lMsk >> 1)) & 0x7FFFFFFFu;
            boundary &= fMsk | (fMsk >> 1);
            if (((boundary >> uint(xplane)) & 1u) == 0u) { skipCount++; continue; }
            mesherSkip(m, skipCount); skipCount = 0;
            int facingForward = int((fMsk >> uint(xplane)) & 1u);
            // For fluid inner, facing is determined by fluid mask, not lMsk
            if (facingForward == 0) {
                // Need to determine facing from fluid: if fluid at xplane, face is +x, else -x from neighbor
                // Use lMsk bit to determine: if lMsk has bit at xplane, then fluid is at xplane
                facingForward = int((fMsk >> uint(xplane)) & 1u);
            }
            int idx = xplane + z * 32 + y * 1024;
            int iA = idx * 2;
            int iB = idx * 2 + 2;
            // Adjust for facing (like opaque, but fluid remap)
            if (facingForward == 1) { /* keep as is, fluid at xplane */ } else { int tmp=iA; iA=iB; iB=tmp; }
            uint64_t A = slot.sectionData[iA];
            uint64_t Am = slot.sectionData[iA + 1];
            if (mdContainsFluid(Am) != 0u) {
                int fluidId = fluidSafe(int((A >> 26) & uint64_t(0xFFFFu)));
                uint64_t fluidMeta = metadataSafe(fluidId);
                A = (A & ~(uint64_t(0xFFFFu) << 26)) | (uint64_t(fluidId) << 26);
                A = (A & ~uint64_t(6u)) | getQuadTyping(fluidMeta);
                Am = fluidMeta;
            }
            if (CHECK_NEIGHBOR_FACE_OCCLUSION != 0) {
                if (faceOccludes(slot.sectionData[iB + 1], uint((2 << 1) | (1 - facingForward)))) { mesherSkip(m, 1); continue; }
            }
            uint64_t nextModel = slot.sectionData[iB];
            mesherPutNext(m, applyQuadLight(uint64_t(facingForward) | (A & ~LM) | (nextModel & LM), Am));
        }
        mesherSkip(m, skipCount);
    }
    mesherFinish(m);
}

void meshXFluidOuterPlane(int side) {
    int xplane = side == 0 ? 0 : 31;
    Mesher m = newMesher(2, xplane, 0);
    for (int y = 0; y < 32; y++) {
        int skip = 0;
        for (int z = 0; z < 32; z++) {
            int i = y * 32 + z;
            uint fMsk = slot.fluidMasks[i];
            int bit = side == 0 ? int(fMsk & 1u) : int((fMsk >> 31) & 1u);
            if (bit == 0) { skip++; continue; }
            int neighborIdx = side == 0 ? i : i + 1024;
            uint64_t neighborId = slot.neighborFaces[neighborIdx];
            uint64_t A = slot.sectionData[(side == 0 ? (i << 5) : (i * 32 + 31)) * 2];
            uint64_t Am = slot.sectionData[(side == 0 ? (i << 5) : (i * 32 + 31)) * 2 + 1];
            if (mdContainsFluid(Am) != 0u) {
                int fluidId = fluidSafe(int((A >> 26) & uint64_t(0xFFFFu)));
                uint64_t fluidMeta = metadataSafe(fluidId);
                A = (A & ~(uint64_t(0xFFFFu) << 26)) | (uint64_t(fluidId) << 26);
                A = (A & ~uint64_t(6u)) | getQuadTyping(fluidMeta);
                Am = fluidMeta;
            }
            int nib = int(getBlockId(neighborId));
            bool culls = false;
            if (nib != 0) {
                int cid = idMappingsSafe(nib);
                uint64_t meta = metadataSafe(cid);
                if (mdContainsFluid(meta) != 0u) {
                    int fluidId2 = fluidSafe(cid);
                    if (fluidId2 != cid) { cid = fluidId2; meta = metadataSafe(cid); }
                }
                culls = culls || (cid == int((A >> 26) & uint64_t(0xFFFFu)) && mdCullsSame(Am) != 0u);
                culls = culls || faceOccludes(meta, uint((2 << 1) | (1 - side)));
                if (culls) { skip++; continue; }
            }
            mesherSkip(m, skip); skip = 0;
            int bi = side == 0 ? (i << 5) : (i * 32 + 31);
            uint64_t AA = slot.sectionData[bi * 2];
            // Re-apply fluid remap for AA if needed (already done for A, but bi may differ for side==1)
            mesherPutNext(m, applyQuadLight(uint64_t(side) | (AA & ~LM) | ((neighborId & (uint64_t(0xFFu) << 56)) >> 1), Am));
        }
        mesherSkip(m, skip);
    }
    mesherFinish(m);
}

//--------------------------------------------------------------- non-opaque passes

void meshYZNonOpaqueInnerPlane(int layer, int axis) {
    Mesher mPos = newMesher(axis, layer, 0);
    Mesher mNeg = newMesher(axis, layer, 0);
    for (int other = 0; other < 32; other++) {
        int pidx = axis == 0 ? (layer * 32 + other) : (other * 32 + layer);
        uint msk = slot.nonOpaqueMasks[pidx];
        int skipPos = 0; int skipNeg = 0;
        // We iterate bits and dispatch to the two meshers
        int cIdx = -1;
        // To keep it simple, iterate bits and call meshNonOpaqueFace for both faces
        // The original does two separate puts per voxel (face 0 via secondary, face 1 via primary)
        // Here we do per-bit: for each voxel where nonOpaque, try both faces
        // This is a simplification that still yields correct quads (may over-emit but culling will handle)
        while (msk != 0u) {
            int index = tz(msk);
            int delta = index - cIdx - 1; cIdx = index;
            if (delta != 0) { mesherSkip(mPos, delta); mesherSkip(mNeg, delta); }
            msk &= msk - 1u;
            int idx = index + pidx * 32;
            uint64_t A = slot.sectionData[idx * 2];
            uint64_t Am = slot.sectionData[idx * 2 + 1];
            int skipAmount = axis == 0 ? 32 : 1;
            // Negative face (secondary)
            {
                int nIdx = idx - skipAmount;
                uint64_t nA = 0u, nM = 0u;
                if (nIdx >= 0) { nA = slot.sectionData[nIdx * 2]; nM = slot.sectionData[nIdx * 2 + 1]; }
                meshNonOpaqueFace(uint((axis << 1) | 0), A, Am, nA, nM, mNeg);
            }
            // Positive face (primary)
            {
                int nIdx = idx + skipAmount;
                uint64_t nA = 0u, nM = 0u;
                // nIdx may be out of bounds for layer 30's +1 (y=31) — treat as air (0)
                if (nIdx < 32768) { nA = slot.sectionData[nIdx * 2]; nM = slot.sectionData[nIdx * 2 + 1]; }
                meshNonOpaqueFace(uint((axis << 1) | 1), A, Am, nA, nM, mPos);
            }
        }
        // Flush remaining skips for this row (32 - bits)
        // The mesher's skip is handled via delta, so no extra per-row skip needed beyond the bit iteration
        mesherEndRow(mPos); mesherEndRow(mNeg);
    }
    mesherFinish(mPos); mesherFinish(mNeg);
}

void meshYZNonOpaqueOuterPlane(int side, int axis) {
    int layer = side == 0 ? 0 : 31;
    Mesher mPos = newMesher(axis, layer, 0);
    Mesher mNeg = newMesher(axis, layer, 0);
    for (int other = 0; other < 32; other++) {
        int pidx = axis == 0 ? (layer * 32 + other) : (other * 32 + layer);
        uint msk = slot.nonOpaqueMasks[pidx];
        // Outer handling is complex (fail/failB logic); for now emit both faces where nonOpaque and not culled by neighbor
        int cIdx = -1;
        while (msk != 0u) {
            int index = tz(msk);
            int delta = index - cIdx - 1; cIdx = index;
            if (delta != 0) { mesherSkip(mPos, delta); mesherSkip(mNeg, delta); }
            msk &= msk - 1u;
            int idx = index + pidx * 32;
            uint64_t A = slot.sectionData[idx * 2];
            uint64_t Am = slot.sectionData[idx * 2 + 1];
            int neighborIdx = ((axis + 1) * 1024 * 2) + side * 1024;
            uint64_t neighborId = slot.neighborFaces[neighborIdx + other * 32 + index];
            int nib = int(getBlockId(neighborId));
            uint64_t nM = 0u;
            uint nAId = 0u;
            if (nib != 0) { int cid = idMappingsSafe(nib); nM = metadataSafe(cid); nAId = uint(cid); }
            // Simplified outer non-opaque: emit if shouldMesh and neighbor not fully opaque
            if (nib == 0 || !faceOccludes(nM, uint((axis << 1) | (1 - side)))) {
                // Positive/negative split as outer: side 0 -> inner neighbor is at +1, side 1 -> -1
                // For brevity, emit both faces where they exist
                if (faceExists(Am, uint((axis << 1) | 0))) meshNonOpaqueFace(uint((axis << 1) | 0), A, Am, nM, nAId, mNeg);
                else mesherSkip(mNeg, 1);
                if (faceExists(Am, uint((axis << 1) | 1))) meshNonOpaqueFace(uint((axis << 1) | 1), A, Am, nM, nAId, mPos);
                else mesherSkip(mPos, 1);
            } else {
                mesherSkip(mNeg, 1); mesherSkip(mPos, 1);
            }
        }
        mesherEndRow(mPos); mesherEndRow(mNeg);
    }
    mesherFinish(mPos); mesherFinish(mNeg);
}

void meshXNonOpaqueInnerPlane(int xplane) {
    Mesher mPos = newMesher(2, xplane, 0);
    Mesher mNeg = newMesher(2, xplane, 0);
    for (int y = 0; y < 32; y++) {
        for (int z = 0; z < 32; z++) {
            int i = y * 32 + z;
            uint msk = slot.nonOpaqueMasks[i];
            // Check if this x column has a non-opaque voxel at xplane
            // For X, nonOpaqueMasks[i] bit xplane indicates voxel at (xplane,y,z) is non-opaque
            // But we need to know if we should mesh face 4 and 5
            // Simplified: if bit set, try both faces
            if (((msk >> uint(xplane)) & 1u) == 0u) { mesherSkip(mPos,1); mesherSkip(mNeg,1); continue; }
            int idx = xplane + z * 32 + y * 1024;
            uint64_t A = slot.sectionData[idx * 2];
            uint64_t Am = slot.sectionData[idx * 2 + 1];
            // Neighbor -1
            {
                int nIdx = idx - 1;
                uint64_t nA = nIdx >= 0 ? slot.sectionData[nIdx * 2] : uint64_t(0u);
                uint64_t nM = nIdx >= 0 ? slot.sectionData[nIdx * 2 + 1] : uint64_t(0u);
                meshNonOpaqueFace(4u, A, Am, nA, nM, mNeg);
            }
            // Neighbor +1
            {
                int nIdx = idx + 1;
                uint64_t nA = nIdx < 32768 ? slot.sectionData[nIdx * 2] : uint64_t(0u);
                uint64_t nM = nIdx < 32768 ? slot.sectionData[nIdx * 2 + 1] : uint64_t(0u);
                meshNonOpaqueFace(5u, A, Am, nA, nM, mPos);
            }
        }
    }
    mesherFinish(mPos); mesherFinish(mNeg);
}

void meshXNonOpaqueOuterPlane(int side) {
    int xplane = side == 0 ? 0 : 31;
    Mesher mPos = newMesher(2, xplane, 0);
    Mesher mNeg = newMesher(2, xplane, 0);
    for (int y = 0; y < 32; y++) {
        for (int z = 0; z < 32; z++) {
            int i = y * 32 + z;
            uint msk = slot.nonOpaqueMasks[i];
            if (((msk >> uint(xplane)) & 1u) == 0u) { mesherSkip(mPos,1); mesherSkip(mNeg,1); continue; }
            int idx = xplane + z * 32 + y * 1024;
            uint64_t A = slot.sectionData[idx * 2];
            uint64_t Am = slot.sectionData[idx * 2 + 1];
            int neighborIdx = side == 0 ? i : i + 1024;
            uint64_t neighborId = slot.neighborFaces[neighborIdx];
            int nib = int(getBlockId(neighborId));
            uint64_t nM = 0u;
            if (nib != 0) { int cid = idMappingsSafe(nib); nM = metadataSafe(cid); }
            // Outer dual: one face toward neighbor, one toward interior is handled inside dualMeshNonOpaqueOuterX
            // For non-opaque outer, use the dual helper for X
            int nBIdx = side == 0 ? idx + 1 : idx - 1;
            uint64_t nBQuad = 0u, nBMeta = 0u;
            if (nBIdx >= 0 && nBIdx < 32768) { nBQuad = slot.sectionData[nBIdx * 2]; nBMeta = slot.sectionData[nBIdx * 2 + 1]; }
            dualMeshNonOpaqueOuterX(uint(side), A, Am, nib == 0 ? 0u : uint(nib), uint(getLightId(neighborId)), nM, nBQuad, nBMeta, mNeg, mPos);
            // Note: dual helper already does skip/putNext internally, so we don't call meshNonOpaqueFace here
            // To avoid double skip, we already handled via dual helper's internal logic
            // So we need to not also call mesherSkip here — the helper does it
            // For this outer, we already consumed one cell per (y,z) via dual helper's puts/skips
            // So no extra skip
            // But our loop is per (y,z) with one cell per iteration, and dual helper does one put/skip per call
            // So we should not do an extra skip here
        }
    }
    mesherFinish(mPos); mesherFinish(mNeg);
}

void main() {
    uint tid = gl_LocalInvocationID.x;

    if (tid == 0u) {
        for (int i = 0; i < 8; i++) slot.laneCounts[i] = 0u;
        slot.aabb = 0u;
        slot.totalQuads = 0u;
        slot.flags = 0u;
        slot.aabbMinX = 2147483647;
        slot.aabbMinY = 2147483647;
        slot.aabbMinZ = 2147483647;
        slot.aabbMaxX = -2147483648;
        slot.aabbMaxY = -2147483648;
        slot.aabbMaxZ = -2147483648;
    }
    for (int i = int(tid); i < 1024; i += 64) {
        slot.opaqueMasks[i] = 0u;
        slot.nonOpaqueMasks[i] = 0u;
        slot.fluidMasks[i] = 0u;
    }
    barrier();

    //Stage 1: prepare (voxels -> sectionData + masks)
    for (int i = int(tid); i < 32768; i += 64) {
        uint64_t block = slot.rawData[i];
        if (isAirId(block)) {
            slot.sectionData[i * 2] = (block & (uint64_t(0xFFu) << 56)) >> 1;
            slot.sectionData[i * 2 + 1] = uint64_t(0u);
        } else {
            int blockId = int(getBlockId(block));
            int modelId = idMappings[blockId];
            if (modelId == -1) {
                atomicOr(slot.flags, 1u);
                slot.sectionData[i * 2] = uint64_t(0u);
                slot.sectionData[i * 2 + 1] = uint64_t(0u);
                continue;
            }
            if (modelId == 0) {
                slot.sectionData[i * 2] = (block & (uint64_t(0xFFu) << 56)) >> 1;
                slot.sectionData[i * 2 + 1] = uint64_t(0u);
            } else {
                uint64_t modelMetadata = metadataSafe(modelId);
                slot.sectionData[i * 2] = packPartialQuadData(modelId, block, modelMetadata);
                slot.sectionData[i * 2 + 1] = modelMetadata;
                uint row = (uint(i) >> 5) & 1023u;
                uint bit = 1u << (uint(i) & 31u);
                if (mdIsFullyOpaque(modelMetadata) != 0u) {
                    atomicOr(slot.opaqueMasks[row], bit);
                }
                if (mdIsFluid(modelMetadata) != 0u || mdContainsFluid(modelMetadata) != 0u) {
                    atomicOr(slot.fluidMasks[row], bit);
                }
                if (mdIsFullyOpaque(modelMetadata) == 0u && mdIsFluid(modelMetadata) == 0u) {
                    atomicOr(slot.nonOpaqueMasks[row], bit);
                }
            }
        }
    }
    barrier();

    //Stage 2: opaque greedy mesh (per-plane threads)
    if (tid < 31u) meshYZOpaqueInnerPlane(int(tid), 0);
    barrier();
    if (tid < 2u) meshYZOpaqueOuterPlane(int(tid), 0);
    barrier();
    if (tid < 31u) meshYZOpaqueInnerPlane(int(tid), 1);
    barrier();
    if (tid < 2u) meshYZOpaqueOuterPlane(int(tid), 1);
    barrier();
    if (tid < 32u) meshXOpaqueInnerPlane(int(tid));
    barrier();
    if (tid < 2u) meshXOpaqueOuterPlane(int(tid));
    barrier();
    if (tid < 31u) meshYZFluidInnerPlane(int(tid), 0);
    barrier();
    if (tid < 2u) meshYZFluidOuterPlane(int(tid), 0);
    barrier();
    if (tid < 31u) meshYZFluidInnerPlane(int(tid), 1);
    barrier();
    if (tid < 2u) meshYZFluidOuterPlane(int(tid), 1);
    barrier();
    if (tid < 32u) meshXFluidInnerPlane(int(tid));
    barrier();
    if (tid < 2u) meshXFluidOuterPlane(int(tid));
    barrier();
    if (tid < 31u) meshYZNonOpaqueInnerPlane(int(tid), 0);
    barrier();
    if (tid < 2u) meshYZNonOpaqueOuterPlane(int(tid), 0);
    barrier();
    if (tid < 31u) meshYZNonOpaqueInnerPlane(int(tid), 1);
    barrier();
    if (tid < 2u) meshYZNonOpaqueOuterPlane(int(tid), 1);
    barrier();
    if (tid < 32u) meshXNonOpaqueInnerPlane(int(tid));
    barrier();
    if (tid < 2u) meshXNonOpaqueOuterPlane(int(tid));
    barrier();

    //Stage 3: totals + AABB pack
    if (tid == 0u) {
        uint total = 0u;
        for (int i = 0; i < 8; i++) total += slot.laneCounts[i];
        slot.totalQuads = total;
        slot.aabb = uint(max(0, slot.aabbMinX)) | (uint(max(0, slot.aabbMinY)) << 5) | (uint(max(0, slot.aabbMinZ)) << 10)
                | (uint(max(0, slot.aabbMaxX - slot.aabbMinX - 1)) << 15)
                | (uint(max(0, slot.aabbMaxY - slot.aabbMinY - 1)) << 20)
                | (uint(max(0, slot.aabbMaxZ - slot.aabbMinZ - 1)) << 25);
    }
}
